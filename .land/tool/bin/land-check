#!/usr/bin/env bash
# land-check [--upstream] [--root DIR]: is the vendored copy of this tool in DIR (default: the repository root) still exactly its pin?
#
# Offline (the default; in Tier 1; well under a second): $LAND_PIN (.land/PIN, beside the tool folder) names the release (source, version, commit, manifest_sha256);
# the tool folder's MANIFEST.sha256 must hash to that value, every file it lists (under $LAND_DIR, and the skills in .agents/skills/) must hash to its entry and have
# its executable bit, and $LAND_DIR may hold nothing else. ANY difference fails: edit the tool in its source repository, not the copy.
# The repository's own files ($LAND_CONF_FILE: known keys only; $LAND_HOOKS_DEFAULT: hooks executable and correctly named, `*.sh` helpers allowed) are checked for being well formed, not for content.
#
# --upstream (the 6-hourly job; by hand): also fetch the manifest at the PINNED COMMIT from the source and require it to equal the local one, so a forged PIN
# and tree together fail; and say whether a newer release exists (advice, never a failure). Exit 3 when the source cannot be reached (not verified).
# Exit codes: 0 ok | 1 drift | 2 not installed or unreadable pin | 3 upstream not reachable (1 wins over 3).
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd); . "$here/../lib/source.sh"; . "$here/../lib/paths.sh"
upstream=0; root=
while [ $# -gt 0 ]; do case $1 in --upstream) upstream=1;; --root) root=${2:?--root needs a directory}; shift;; *) echo "usage: land-check [--upstream] [--root DIR]" >&2; exit 2;; esac; shift; done
[ -n "$root" ] || root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/land-check.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
. "$here/../lib/conf.sh"; conf_defaults
allbad=0; unreach=0
check_one() {   # the pin, the manifest, every listed file (hash, executable bit), nothing extra; with --upstream the source's manifest at the pinned commit
  local pdir=$LAND_DIR label=vbm-land pin man p_source p_version p_commit p_msha h f v upd=$LAND_DIR/bin/land-update bad=0 msg latest e
  pin=$root/$LAND_PIN; man=$root/$LAND_MANIFEST_FILE   # the pin sits beside the tool folder, the manifest inside it
  [ -r "$pin" ] && [ -r "$man" ] || { echo "land-check: no pinned copy in $root ($LAND_PIN or $LAND_MANIFEST_FILE missing): not installed" >&2; exit 2; }
  pinval() { sed -n "s/^$1=//p" "$pin" | sed -n 1p; }
  p_source=$(pinval source); p_version=$(pinval version); p_commit=$(pinval commit); p_msha=$(pinval manifest_sha256)
  [ -n "$p_source" ] && [[ "$p_commit" =~ ^[0-9a-f]{40}$ ]] && [[ "$p_msha" =~ ^[0-9a-f]{64}$ ]] || { echo "land-check: $LAND_PIN is unreadable (needs source=, version=, a 40-hex commit= and a manifest_sha256=)" >&2; exit 2; }
  drift() { echo "DRIFT: $*" >&2; bad=1; }
  [ "$(sha256sum < "$man" | cut -d' ' -f1)" = "$p_msha" ] || drift "$LAND_MANIFEST_FILE does not hash to the pin's manifest_sha256"
  declare -A listed=()
  while read -r h f; do
    [ -n "$f" ] || continue; v=$(land_vpath "$f"); listed[$v]=1
    if [ ! -f "$root/$v" ]; then drift "$v is missing"; continue; fi
    [ "$(sha256sum < "$root/$v" | cut -d' ' -f1)" = "$h" ] || drift "$v differs from the pinned release"
    case $f in bin/*) [ -x "$root/$v" ] || drift "$v is not executable";; esac
  done < "$man"
  while IFS= read -r f; do f=${f#"$root"/}; case $f in "$LAND_MANIFEST_FILE") continue;; esac   # the manifest is the only file under $pdir that lists itself
    [ -n "${listed[$f]:-}" ] || drift "$f is not part of the pinned release (an extra or local file inside the vendored tree)"
  done < <(find "$root/$pdir" -type f -not -path '*/.lake/*' | LC_ALL=C sort)   # a Lake build product (the tool's package builds in place) is not part of a release
  # the repository's own files: well formed. $LAND_ENTRY is the repository's own entry script (install creates it from templates/land-direct-stub when absent; add what you need before the exec):
  # it must be executable and still run the pinned lander, named either from the repository root ($LAND_DIR/bin/land-direct) or, as the stub does, beside itself (tool/bin/land-direct).
  e=$(grep -v '^[[:space:]]*#' "$root/$LAND_ENTRY" 2>/dev/null || true)
  lander_rel=${LAND_DIR#"$(dirname "$LAND_ENTRY")"/}   # $LAND_DIR as the entry script sees it, from its own folder (.land/land-direct -> tool)
  { [ -x "$root/$LAND_ENTRY" ] && { [[ $e == *"$LAND_DIR/bin/land-direct"* ]] || [[ $e == *"$lander_rel/bin/land-direct"* ]]; }; } || drift "$LAND_ENTRY is missing, not executable, or does not run the pinned lander ($LAND_DIR/bin/land-direct)"
  # RETIRED PATHS (docs/payload.md 5): files that moved into the payload; a repository carries no copy of them. A link that resolves INTO the vendored tool is allowed (the old layout tracked such links and the migration repoints them): it is the vendored bytes, it cannot diverge. Any other file or link fails.
  local rl=$root/$LAND_DIR/lib/retired-paths.txt rp rrest
  if [ -r "$rl" ]; then
    while read -r rp rrest; do
      case $rp in ''|'#'*) continue;; esac
      if { [ -e "$root/$rp" ] || [ -L "$root/$rp" ]; } && ! { [ -L "$root/$rp" ] && case $(readlink -f "$root/$rp" 2>/dev/null) in "$(readlink -f "$root/$LAND_DIR")"/*) true;; *) false;; esac; }; then drift "$rp is retired: ${rrest:-see docs/payload.md}; delete the repository's copy"; fi
    done < "$rl"
  fi
  if [ -r "$root/$LAND_LEAN_CONF_FILE" ]; then ( lean_conf_defaults; conf_parse "$LAND_LEAN_CONF_FILE" "$lean_conf_keys" < "$root/$LAND_LEAN_CONF_FILE" && lean_conf_validate ) 2>&1 >/dev/null | sed 's/^/DRIFT: /' >&2 && [ "${PIPESTATUS[0]}" = 0 ] || bad=1; fi
  if [ -r "$root/$LAND_CONF_FILE" ]; then ( conf_defaults; conf_parse "$LAND_CONF_FILE" < "$root/$LAND_CONF_FILE" ) 2>&1 >/dev/null | sed 's/^/DRIFT: /' >&2 && [ "${PIPESTATUS[0]}" = 0 ] || bad=1; fi
  if [ -d "$root/$LAND_HOOKS_DEFAULT" ]; then   # hooks have fixed names and must be executable; `*.sh` files are helpers the hooks source; anything else is a hook that would silently never run
    for h in "$root/$LAND_HOOKS_DEFAULT"/*; do [ -f "$h" ] || continue; n=${h##*/}
      case $n in
        prepare|pre-rebase|post-rebase|post-tier1|json-fields|on-run) [ -x "$h" ] || drift "$LAND_HOOKS_DEFAULT/$n is not executable (a hook that is not executable is silently never run)";;
        *.sh) ;;
        *) drift "$LAND_HOOKS_DEFAULT/$n is not a hook name (prepare, pre-rebase, post-rebase, post-tier1, json-fields, on-run) nor a *.sh helper: it would silently never run";;
      esac
    done
  fi
  if [ "$bad" != 0 ]; then allbad=1; echo "land-check: the vendored copy of $label differs from its pin ($p_version, ${p_commit:0:12}). Edit vbm-land, not the copy; restore it with $upd $p_version." >&2; return 0; fi
  msg="land-check: ok: $label $p_version (${p_commit:0:12}) is intact"
  if [ "$upstream" = 0 ]; then echo "$msg"; return 0; fi
  rm -rf "$tmp/src"; src_fetch "$p_source" "$p_commit" "$tmp/src" >"$tmp/commit" 2>"$tmp/err" || { echo "land-check: cannot reach the source $p_source to verify the pin: $(cat "$tmp/err")" >&2; unreach=1; return 0; }
  [ "$(cat "$tmp/commit")" = "$p_commit" ] || { echo "DRIFT: the pinned commit $p_commit is not what the source resolves it to" >&2; allbad=1; return 0; }
  git -C "$tmp/src" show "$p_commit:MANIFEST.sha256" > "$tmp/manifest" 2>/dev/null || { echo "DRIFT: the source has no MANIFEST.sha256 at the pinned commit" >&2; allbad=1; return 0; }
  cmp -s "$tmp/manifest" "$man" || { echo "DRIFT: the manifest at the pinned commit $p_commit in $p_source differs from the vendored one (a forged pin and tree?)" >&2; allbad=1; return 0; }
  echo "$msg; the source confirms the manifest at the pinned commit"
  latest=$(git -C "$tmp/src" tag --list 'v[0-9]*' 2>/dev/null | LC_ALL=C sort -V | tail -n1 || true)
  if [ -n "$latest" ] && [ "$latest" != "$p_version" ] && [ "$(printf '%s\n%s\n' "$p_version" "$latest" | LC_ALL=C sort -V | tail -n1)" = "$latest" ]; then echo "land-check: advice: a newer release exists: $latest (pinned: $p_version). $upd $latest"; fi
}
check_one
[ "$allbad" = 0 ] || exit 1
[ "$unreach" = 0 ] || exit 3
exit 0
