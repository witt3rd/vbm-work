#!/usr/bin/env bash
# land-direct: land the worker's LOCAL commits DIRECT ON THE BASE BRANCH (default main): no branch pushed, no pull request, one coordinator.
#
#   land-direct [--dry-run] [--check] [--group] [--conf PATH] [<rev>]   lands the commits <remote>/<base>..<rev> (default HEAD) of the worktree it is run in,
#                                                             each as itself (linear history). --check runs only the land-time checks.
#   --group: the commits are batch entries a coordinator already checked one by one: the size budget is waived.
#   land-direct --hold "<reason>" | --release                 stop / allow landings in this clone (checked at the start and again before the push)
#   land-direct --freeze "<reason>" --owner NAME --for 6h     freeze landing but for fixes and reverts (owner and expiry are required) | --thaw
#   land-direct --status | --version
#
# What it does (NO LOCK: any number of landers run at once, each in its own run directory; the remote's refusal of a push that is not a fast-forward is the only arbiter):
#   hold? -> fetch -> land-time checks on every commit (Conventional subject, required trailers) -> hold? -> frozen? (a person's freeze: only a fix or a revert lands, recognised by its subject; a RED main does not
#   stop landing: whoever sees it reverts the commit that made it red with git revert; nothing runs after the push, no CI is read) -> rebase the commits onto <remote>/<base> in this run's own scratch
#   worktree (<git common dir>/vbm-land/run.<pid>.<random>/wt, removed at exit; a conflict ONLY in generated files takes base's file and regenerates) -> hooks -> Tier 1 (the gates command, then the test
#   command) on that exact combination -> fetch again: base moved during Tier 1 = rebase and check again (up to LAND_ATTEMPTS attempts within LAND_DEADLINE seconds, then exit 16) -> `git push <remote> <sha>:<base>`, a
#   plain fast-forward push: there is no force anywhere in this script.
#
# CONFIGURATION is the repository's own file (default $LAND_CONF_FILE, lib/paths.sh; lib/conf.sh documents every key). It is read from <remote>/<base>, i.e. from what main
# already says, so a commit cannot loosen the rules it is judged by; only when main has no such file yet (the first landing) is the working tree's copy used.
# HOOKS are repository-owned executables in LAND_HOOKS_DIR, taken from <remote>/<base> too: pre-rebase, post-rebase, post-tier1, json-fields, on-run, prepare.
#
# Exit codes (the contract): 0 landed | 1 stopped with a plain message (base kept moving, push refused, a bad commit message) | 2 bad input or bad config |
#   11 rebase conflict: aborted, the files are named; resolve in your worktree (git fetch && git rebase <remote>/<base>) and run again |
#   12 refused by a hook, the protected-set rules, the vendored-copy drift check, or a regeneration that failed | 13 Tier 1 fails (nothing lands) | 14 held or frozen |
#   16 base moved faster than the lander could validate (LAND_ATTEMPTS / LAND_DEADLINE used up): nothing was pushed; run it again. Run again after a crash that followed an accepted push: exit 0, "already landed".
# The LAST line of stdout is JSON: {"sha","commits","tier1_seconds","result","exit"} plus any keys a `json-fields` hook prints (null where not known; result: landed,
#   would-land, checked, conflict, refused, tier1, held, moved, error). Every run also appends one line to the metrics log
#   ($LAND_DIRECT_LOG, default <git common dir>/vbm-land/metrics.jsonl): ts, result, commits, commit (the tip handed over), attempts, inherited_red, tier1_s, total_s.
#   Tier 1 that fails ONLY with failures the bare base already has (LAND_FAIL_PATTERN lines; one extra run, only then) passes as "inherited red": a landing must not ADD a failure.
# BOUNDED: every step runs under `timeout --kill-after=30`: LAND_TIER1_TIMEOUT (Tier 1, regeneration of generated files by Tier 1 is part of it), LAND_STEP_TIMEOUT
#   (hooks, regeneration), LAND_GIT_TIMEOUT (fetch, push). A step that runs over is killed with one plain line and the run stops as that step's failure.
# Operator environment (not policy): REMOTE-independent knobs LAND_CONF, LAND_FIX_FOR_RED=1 (treat this change as a fix, so it passes a freeze), LAND_DIRECT_LOG, and the
#   timeouts above. Policy keys are never read from the environment.
# Commands the lander runs get: LAND_TOP (the worktree landed from), LAND_BASE_REF (<remote>/<base>), LAND_STATE_DIR (shared by every run of the clone: hold, freeze, metrics), LAND_RUN_DIR (this run's own: scratch worktree, hooks, logs), LAND_ATTEMPT (1, 2, ...) and LAND_PREV_BASE (the base commit the last attempt validated against; empty on the first), LAND_TASK (the tip's first required trailer value).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); lib=$here/../lib
. "$lib/conf.sh"; . "$lib/freeze.sh"; . "$lib/paths.sh"
# operator knobs first, then clear every policy variable so only the repository's file can set policy
o_t1=${LAND_TIER1_TIMEOUT:-}; o_st=${LAND_STEP_TIMEOUT:-}; o_gt=${LAND_GIT_TIMEOUT:-}; o_conf=${LAND_CONF:-}; o_fixred=${LAND_FIX_FOR_RED:-}
conf_defaults

usage() { echo "usage: land-direct [--dry-run] [--check] [--group] [--conf PATH] [<rev>] | --hold REASON | --release | --freeze REASON --owner NAME --for DURATION | --thaw | --status | --print-gate-diff-hash FILE-SET [<rev>] | --print-gate-diff FILE-SET [<rev>] | --version" >&2; exit 2; }
dry=0; checkonly=0; group=0; confpath=$LAND_CONF_FILE; [ -z "$o_conf" ] || confpath=$o_conf; args=(); op=; opreason=; owner=; dur=; pfile=
while [ $# -gt 0 ]; do case $1 in
  --dry-run) dry=1;; --check) checkonly=1;; --group) group=1;;
  --conf) confpath=${2:?--conf needs a path}; shift;;
  --hold|--freeze) op=${1#--}; opreason=${2:?$1 needs a reason}; shift;;
  --release|--thaw|--status) op=${1#--};;
  --owner) owner=${2:?--owner needs a name}; shift;; --for) dur=${2:?--for needs a duration}; shift;;
  --version) echo "land-direct $(cat "$here/../VERSION" 2>/dev/null || echo unknown)"; exit 0;;
  -*) usage;; *) args+=("$1");; esac; shift; done
[ ${#args[@]} -le 1 ] || usage
rev=${args[0]:-HEAD}

hooks=; wt=; sha=; ncommits=; t1=; result=error; t0=$(date +%s); common=; state=; run=; extra_json=; tip0=; attempt=0; already=0; inherited=0; stage=; newfail=; hookcwd=
reason=; step=start; lastlines=
jesc() { awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); gsub(/\r/,""); if (NR>1) print "\\n"; print}'; }
json_num() { [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+)?$ ]] && printf '%s' "$1" || printf null; }
json_str() { [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] && printf '"%s"' "$1" || printf null; }
onexit() {
  local c=$?
  [ -z "$op" ] || { run_cleanup "$c"; exit "$c"; }
  if [ -n "$state" ] && [ -d "$state" ]; then   # the measurements, one O_APPEND line each: landings per hour, commit-to-main time
    printf '{"ts":%s,"result":"%s","commits":%s,"commit":%s,"attempts":%s,"inherited_red":%s,"tier1_s":%s,"total_s":%s,"exit":%s,"step":"%s","reason":"%s","last_lines":"%s"}\n' "$(date +%s)" "$result" "$(json_num "$ncommits")" "$(json_str "$tip0")" "$(json_num "$([ "$attempt" = 0 ] || echo "$attempt")")" "$([ "$inherited" = 1 ] && echo true || echo false)" "$(json_num "$t1")" "$(( $(date +%s) - t0 ))" "$c" "$step" "$(printf '%s\n' "$reason" | jesc)" "$(printf '%s\n' "$lastlines" | jesc)" >> "${LAND_DIRECT_LOG:-$state/metrics.jsonl}" 2>/dev/null || true
  fi
  run_hook on-run >/dev/null 2>&1 || true
  printf '{"sha":%s,"commits":%s,"tier1_seconds":%s,"result":"%s","exit":%s%s}\n' "$(json_str "$sha")" "$(json_num "$ncommits")" "$(json_num "$t1")" "$result" "$c" "$extra_json"
  run_cleanup "$c"
}
# run_cleanup EXITCODE: this run's scratch worktree always goes (through git, never `worktree prune`); on success the whole run dir, on a failure only its *.log files stay (the next run's sweep removes them after a day)
run_cleanup() {
  [ -n "$run" ] && [ -d "$run" ] || return 0
  [ ! -e "$run/wt/.git" ] || git -C "$top" worktree remove -f "$run/wt" >/dev/null 2>&1 || true
  if [ "$1" = 0 ]; then rm -rf "$run"; else find "$run" -mindepth 1 -maxdepth 1 ! -name '*.log' -exec rm -rf {} + 2>/dev/null || true; fi
}
trap onexit EXIT
# bounded SECS LABEL CMD...: the command under `timeout --kill-after=30`; over the bound it is killed and one plain line says which step and how long. Returns its exit code.
bounded() { local s=$1 label=$2 rc=0; shift 2; timeout --kill-after=30 "$s" "$@" || rc=$?
  if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then echo "land-direct: TIMED OUT: $label ran past ${s}s and was killed (exit $rc)" >&2; fi; return "$rc"; }
stop() { local code=$1; result=$2; shift 2; reason="$*"; echo "land-direct: $*" >&2; exit "$code"; }
die() { stop 1 error "$*"; }
badinput() { echo "land-direct: $*" >&2; exit 2; }

top=$(git rev-parse --show-toplevel 2>/dev/null) || badinput "not inside a git worktree"
common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir); state=$common/vbm-land; mkdir -p "$state"
holdf=$state/hold; freezef=$state/freeze
holdcheck() { [ ! -e "$holdf" ] || stop 14 held "HOLD in force: $(sed -n 1p "$holdf" 2>/dev/null); not landing. land-direct --release lifts it."; }

# ---- operator operations (no landing)
case $op in
  hold) [ -n "$opreason" ] || badinput "--hold needs a reason"; printf '%s (set %s)\n' "$opreason" "$(date -u +%FT%TZ)" > "$holdf"; echo "land-direct: HOLD set: $opreason"; exit 0;;
  release) rm -f "$holdf"; echo "land-direct: hold released"; exit 0;;
  freeze) [ -n "$owner" ] && [ -n "$dur" ] || badinput "--freeze needs --owner NAME and --for DURATION (a freeze has a named owner and an expiry)"
    [[ "$dur" =~ ^([0-9]+)([smhd])$ ]] || badinput "--for takes N followed by s, m, h or d (e.g. 6h)"
    case ${BASH_REMATCH[2]} in s) unit=1;; m) unit=60;; h) unit=3600;; *) unit=86400;; esac; secs=$(( BASH_REMATCH[1] * unit ))
    [[ "$owner" =~ ^[A-Za-z0-9._@-]+$ ]] || badinput "--owner: letters, digits and ._@- only"
    now=$(date +%s); printf 'owner=%s\nreason=%s\nsince=%s\nexpires=%s\n' "$owner" "$(echo "$opreason" | tr '\n' ' ')" "$now" "$((now + secs))" > "$freezef"
    echo "land-direct: FROZEN until $(date -u -d "@$((now + secs))" +%FT%TZ) by $owner: only a fix or a revert lands. land-direct --thaw lifts it."; exit 0;;
  thaw) rm -f "$freezef"; echo "land-direct: freeze lifted"; exit 0;;
  status) if [ -e "$holdf" ]; then echo "hold: $(sed -n 1p "$holdf")"; else echo "hold: none"; fi
    if freeze_active "$freezef"; then echo "freeze: $(freeze_describe "$freezef")"; else echo "freeze: none"; fi
    exit 0;;
esac

# ---- this run's own directory: <git common dir>/vbm-land/run.<pid>.<random> holds everything this run writes (scratch worktree, hooks, logs, scratch files), so no two runs share a file.
# Leftovers of runs that died (their pid is gone and the directory is over a day old) are swept here; a symlink or a live pid's directory is never touched.
for d in "$state"/run.*; do
  p=${d##*/run.}; p=${p%%.*}; [ -d "$d" ] && [ ! -L "$d" ] && [[ "$p" =~ ^[0-9]+$ ]] && [ ! -d "/proc/$p" ] && [ -n "$(find "$d" -maxdepth 0 -mmin +1440 2>/dev/null)" ] || continue
  [ ! -e "$d/wt/.git" ] || git -C "$top" worktree remove -f "$d/wt" >/dev/null 2>&1 || true
  rm -rf "$d"
done
run=$(mktemp -d "$state/run.$$.XXXXXX") || badinput "cannot create a run directory under $state"
export LAND_RUN_DIR=$run
# fetch_base SECS DIR: fetch the base branch. Landers of one clone fetch into the same remote-tracking ref and git refuses the loser ("cannot lock ref"): that one transient refusal is retried, anything else is a failure.
fetch_base() { local i rc=0
  for i in 1 2 3 4 5 6 7 8; do
    rc=0; bounded "$1" "git fetch" git -C "$2" -c core.filesRefLockTimeout=2000 fetch -q "$remote" "$base" 2>"$run/fetch.err" || rc=$?
    [ "$rc" != 0 ] || return 0
    grep -q 'cannot lock ref\|\.lock' "$run/fetch.err" || break
    sleep "0.$((RANDOM % 9 + 1))"
  done
  cat "$run/fetch.err" >&2; return "$rc"
}

holdcheck
# ---- fetch, then the repository's configuration (from the base branch; the working tree's copy only when the base has none yet)
remote=origin; base=$(git -C "$top" symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s|^$remote/||" || true)   # to find the config we first need the remote's default branch
[ -n "$base" ] || base=$(git -C "$top" ls-remote --symref "$remote" HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p' | sed -n 1p || true)
[ -n "$base" ] || base=main
git -C "$top" remote get-url "$remote" >/dev/null 2>&1 || badinput "no remote named $remote"
step=fetch; fetch_base "${o_gt:-$LAND_GIT_TIMEOUT}" "$top" || die "cannot fetch $remote $base"
if [ -n "$o_conf" ] && [ -r "$o_conf" ]; then conf_parse "$o_conf" < "$o_conf" || exit 2; confsrc=$o_conf
elif git -C "$top" cat-file -e "$remote/$base:$confpath" 2>/dev/null; then conf_parse "$remote/$base:$confpath" < <(git -C "$top" show "$remote/$base:$confpath") || exit 2; confsrc="$remote/$base:$confpath"
elif [ -r "$top/$confpath" ]; then conf_parse "$confpath" < "$top/$confpath" || exit 2; confsrc="$confpath (working tree: $base has no $confpath yet)"
else badinput "no configuration: $remote/$base has no $confpath and neither has the working tree (see lib/conf.sh)"; fi
conf_validate || exit 2
if [ "$LAND_REMOTE" != "$remote" ] || [ "$LAND_BASE" != "$base" ]; then   # the file names another remote or base: fetch that one
  remote=$LAND_REMOTE; base=$LAND_BASE
  git -C "$top" remote get-url "$remote" >/dev/null 2>&1 || badinput "LAND_REMOTE=$remote: no such remote"
  fetch_base "${o_gt:-$LAND_GIT_TIMEOUT}" "$top" || die "cannot fetch $remote $base"
fi
export LC_ALL=$LAND_LOCALE
lt=${o_t1:-$LAND_TIER1_TIMEOUT}; st=${o_st:-$LAND_STEP_TIMEOUT}; gt=${o_gt:-$LAND_GIT_TIMEOUT}
export LAND_TOP=$top LAND_BASE_REF=$remote/$base LAND_STATE_DIR=$state
read -ra prot_globs <<<"$LAND_PROTECTED"

tip0=$(git -C "$top" rev-parse --verify -q "$rev^{commit}") || badinput "no such revision: $rev"
commits=$(git -C "$top" rev-list --reverse --topo-order "$remote/$base..$tip0")
[ -n "$commits" ] || badinput "nothing to land: $rev is already in $remote/$base"
[ -z "$(git -C "$top" rev-list --merges "$remote/$base..$tip0")" ] || badinput "$rev has merge commits: history lands linear; rebase onto $remote/$base first"
ncommits=$(wc -l <<<"$commits")
[ "$rev" != HEAD ] || [ -z "$(git -C "$top" status --porcelain --untracked-files=no)" ] || echo "land-direct: note: uncommitted changes in $top are not landed (only the $ncommits commit(s))" >&2

# ---- land-time checks, per commit
matches_any() { local f=$1 g; shift; for g in "$@"; do [[ "$f" == $g ]] && return 0; done; return 1; }   # shell patterns; * matches /
types=$(echo $LAND_COMMIT_TYPES | tr ' ' '|')
conv_re="^(${types})(\\([a-z0-9_,./-]+\\))?!?: ..*|^Revert \".+\""
fix_subject_re='^(fix(\([^)]*\))?:|[Rr]evert)'   # `fix:` or `fix(<any scope>):`, or a revert: the subject alone decides, never the paths it touches
commit_is_fix() {   # a fix for a frozen base: a `fix:` / `fix(<scope>):` subject, or a subject that starts with Revert/revert (recognised by its subject, never by the paths it touches)
  local subj; subj=$(git -C "$top" log -1 --format=%s "$1")
  [[ "$subj" =~ $fix_subject_re ]]
}
budget=; allfix=1; step=land-time-checks
for c in $commits; do
  subj=$(git -C "$top" log -1 --format=%s "$c"); body=$(git -C "$top" log -1 --format=%B "$c" | tr -d '\r')
  if [ "$LAND_CONVENTIONAL" = 1 ]; then grep -qE "$conv_re" <<<"$subj" || die "commit ${c:0:12}: the subject is not a Conventional Commit 'type(scope): summary' (types: $LAND_COMMIT_TYPES): '$subj'"; fi
  for t in $LAND_REQUIRE_TRAILERS; do grep -qE "^$t: ..*" <<<"$body" || die "commit ${c:0:12} ($subj): no '$t:' trailer (a '$t: <value>' line at the end of the commit message)"; done
  commit_is_fix "$c" || allfix=0
done
isfix=$allfix; [ "$o_fixred" != 1 ] || isfix=1
gen_list() { git -C "$top" show "$remote/$base:$LAND_GENERATED_LIST" 2>/dev/null | sed 's/#.*//; s/[[:space:]]//g; /^$/d' || true; }
gen=; [ -z "$LAND_GENERATED_LIST" ] || gen=$(gen_list)
echo "land-direct: $ncommits commit(s); config $confsrc"
[ "$checkonly" = 0 ] || { result=checked; echo "land-direct: --check: the land-time checks pass; nothing rebased, tested or pushed"; exit 0; }
first_trailer=${LAND_REQUIRE_TRAILERS%% *}; task=
[ -z "$first_trailer" ] || task=$(git -C "$top" log -1 --format=%B "$tip0" | sed -n "s/^$first_trailer: *//p" | sed -n 1p)
export LAND_TASK=$task

# ---- hooks: executables of LAND_HOOKS_DIR taken from <remote>/<base> (the rules main already has judge this change); the working tree's only before main has any
prepare_hooks() {
  hooks=$run/hooks; rm -rf "$hooks"; mkdir -p "$hooks"
  if git -C "$top" cat-file -e "$remote/$base:$LAND_HOOKS_DIR" 2>/dev/null; then
    git -C "$top" archive "$remote/$base" -- "$LAND_HOOKS_DIR" | tar -x -C "$hooks" --strip-components="$(awk -F/ '{print NF}' <<<"$LAND_HOOKS_DIR")" 2>/dev/null || true
  elif [ -d "$wt/$LAND_HOOKS_DIR" ]; then cp -a "$wt/$LAND_HOOKS_DIR/." "$hooks/"; fi
}
# run_hook NAME [ARGS]: runs the hook in the scratch worktree, bounded; its output goes to stderr. Returns its exit code (0 when there is no such hook).
run_hook() { local n=$1; shift; [ -n "$hooks" ] && [ -x "$hooks/$n" ] || return 0
  (cd "${hookcwd:-$wt}" && LAND_RESULT=$result LAND_SHA=$sha LAND_COMMITS=$ncommits LAND_TIER1_SECONDS=$t1 bounded "$st" "hook $n" "$hooks/$n" "$@") >&2; }

# ---- a freeze (a person's: a named owner and an expiry) stops landing but for a fix or a revert. A RED main does not: whoever sees it reverts the commit that made it red with git revert.
freezecheck() { freeze_active "$freezef" || return 0
  [ "$isfix" = 1 ] && echo "land-direct: $base is frozen; this change is a fix or a revert: landing" || stop 14 held "$base is frozen ($(freeze_describe "$freezef")): only a fix or a revert lands (a subject starting fix:, fix(<scope>): or Revert)"; }

holdcheck; freezecheck

# Tier 1 is two stages, the gates command then the test command. t1stage STAGE DIR LOG runs one of them in DIR (no command = nothing to run); 0 = green.
t1cmd() { case $1 in gates) echo "$LAND_GATES_CMD";; *) echo "$LAND_TEST_CMD";; esac; }
t1stage() { local c; c=$(t1cmd "$1"); [ -z "$c" ] || (cd "$2" && bounded "$lt" "Tier 1 $1" bash -c "$c") >"$3" 2>&1; }
# inherited_red STAGE: a landing must not ADD a failure, and one already on the base is not its fault. Every failure of this stage (the log lines matching LAND_FAIL_PATTERN) must also
# be a failure of the same stage on the bare base commit (one extra run, only here, in a scratch worktree of its own, prepared like the landing's). No recognisable failure line = no inheritance.
inherited_red() {
  local mine theirs; newfail=; mine=$(grep -E "$LAND_FAIL_PATTERN" "$run/tier1.$1.log" | LC_ALL=C sort -u || true); [ -n "$mine" ] || return 1
  rm -rf "$run/base"; git -C "$top" worktree add -q -f --detach "$run/base" "$bsha" || return 1
  hookcwd=$run/base run_hook prepare || return 1
  t1stage "$1" "$run/base" "$run/base.log" || true
  theirs=$(grep -E "$LAND_FAIL_PATTERN" "$run/base.log" | LC_ALL=C sort -u || true)
  newfail=$(comm -23 <(printf '%s\n' "$mine") <(printf '%s\n' "$theirs") | sed -n 1p | cut -c1-200)
  git -C "$top" worktree remove -f "$run/base" >/dev/null 2>&1 || true
  [ -z "$newfail" ]; }

# ---- the scratch worktree: ours, by path. Never `git worktree prune`: the clone is shared with other lanes' worktrees.
wt=$run/wt; git -C "$top" worktree add -q -f --detach "$wt" "$remote/$base"
g() { git -C "$wt" "$@"; }
prepare_hooks
run_hook prepare || stop 12 refused "the prepare hook failed"
# more: another attempt only within LAND_ATTEMPTS attempts and LAND_DEADLINE seconds of the start; past either, exit 16 (nobody holds anything: the base moved faster than this run could validate)
deadline=$((t0 + LAND_DEADLINE)); prev=
more() { [ "$attempt" -lt "$LAND_ATTEMPTS" ] && [ "$(date +%s)" -lt "$deadline" ] || stop 16 moved "$base moved faster than I could validate: $attempt attempt(s) in $(( $(date +%s) - t0 ))s (at most $LAND_ATTEMPTS, within ${LAND_DEADLINE}s); nothing landed; run land-direct again."; }
while :; do
  attempt=$((attempt + 1))
  fetch_base "$gt" "$wt" || die "cannot fetch $remote $base (timed out or failed)"
  bsha=$(g rev-parse --verify "$remote/$base^{commit}")   # the base of THIS attempt, pinned: other landers of the clone move the shared $remote/$base ref under us
  g reset -q --hard; g clean -fdq; g checkout -q --detach "$tip0"; regenned=0
  step=rebase; run_hook pre-rebase || stop 12 refused "the pre-rebase hook refused this change"
  if ! g rebase -q "$bsha" >/dev/null 2>&1; then
    while [ -d "$(g rev-parse --path-format=absolute --git-path rebase-merge)" ] || [ -d "$(g rev-parse --path-format=absolute --git-path rebase-apply)" ]; do
      conflicted=$(g diff --name-only --diff-filter=U); other=$(grep -vxFf <(printf '%s\n' "$gen") <<<"$conflicted" || true)
      if [ -n "$other" ] || [ -z "$conflicted" ] || [ -z "$gen" ]; then
        g rebase --abort; stop 11 conflict "your commit(s) conflict with $base in files that are not generated: $(echo $conflicted | tr ' ' '\n' | LC_ALL=C sort -u | paste -sd' '). Resolve it in your worktree: git fetch $remote && git rebase $remote/$base, then run land-direct again."
      fi
      for f in $conflicted; do { g checkout --ours -- "$f" && g add -- "$f"; } 2>/dev/null || g rm -q -- "$f"; done   # during a rebase "ours" is base
      regenned=1; GIT_EDITOR=true g rebase --continue >/dev/null 2>&1 || true
    done
  fi
  if [ "$regenned" = 0 ] && [ "$(g rev-parse HEAD)" = "$bsha" ]; then already=1; sha=$bsha; break; fi   # every commit is already in the base (a crash after an accepted push, a rerun): nothing to rebuild or test
  if [ "$regenned" = 1 ]; then
    [ -n "$LAND_REGEN_CMD" ] || stop 12 refused "generated files conflicted and LAND_REGEN_CMD is not set: they cannot be regenerated; not landing."
    echo "land-direct: generated files conflicted: took $base's and regenerating"
    rc=0; (cd "$wt" && bounded "$st" "regenerate (conflict)" bash -c "$LAND_REGEN_CMD") >"$run/regen.log" 2>&1 || rc=$?
    [ "$rc" = 0 ] || { tail -3 "$run/regen.log" >&2; stop 12 refused "the regeneration after a conflict in generated files failed (exit $rc; log: $run/regen.log); not landing."; }
  fi
  if [ -n "$LAND_GEN_CMD" ]; then   # always regenerated on the rebased tree: two commits that each regenerated correctly can disagree once both are on base
    rc=0; (cd "$wt" && bounded "$st" "regenerate" bash -c "$LAND_GEN_CMD") >"$run/gen.log" 2>&1 || rc=$?
    [ "$rc" = 0 ] || { tail -3 "$run/gen.log" >&2; stop 13 tier1 "the generated files cannot be regenerated (exit $rc; log: $run/gen.log); not landing."; }
  fi
  # the protected set, judged on what would land (the rebased tree against base): touching it is allowed; the hooks and Tier 1 must pass
  g diff --name-only "$bsha" > "$run/touched.txt"; export LAND_TOUCHED_FILE=$run/touched.txt; prot_hit=
  if [ ${#prot_globs[@]} -gt 0 ]; then while IFS= read -r f; do matches_any "$f" "${prot_globs[@]}" && prot_hit="$prot_hit $f"; done < "$run/touched.txt"; fi
  export LAND_PROTECTED_TOUCHED=${prot_hit# }
  [ -z "$prot_hit" ] && echo "land-direct: protected set: none touched" || echo "land-direct: protected set: TOUCHED ($LAND_PROTECTED_TOUCHED): allowed, every gate must pass"
  if [ "${LAND_OWNER:-}" != 1 ]; then while IFS= read -r f; do   # a signing keys file that already exists changes only by its owner (a first install of one is not a change)
    case $f in *.signers) ! g cat-file -e "$bsha:$f" 2>/dev/null || stop 12 refused "$f (a signing keys file) changes only by its owner (LAND_OWNER=1); not landing.";; esac; done < "$run/touched.txt"; fi
  step=post-rebase-hook; run_hook post-rebase || stop 12 refused "the post-rebase hook refused this change (protected set / gate checks; see above)"
  if [ -x "$wt/$LAND_DIR/bin/land-check" ] && [ -e "$wt/$LAND_PIN" ]; then   # a vendored copy of this tool: it must still be what its pin says
    rc=0; (cd "$wt" && bounded "$st" "vendored-copy drift check" "$LAND_DIR/bin/land-check") >&2 || rc=$?
    [ "$rc" = 0 ] || stop 12 refused "the vendored copy of this tool under $LAND_DIR/ differs from its pin (edit the source repository, not the copy); not landing."
  fi
  export LAND_ATTEMPT=$attempt LAND_PREV_BASE=$prev; ts=$(date +%s)
  for stage in gates tests; do
    step=tier1-$stage; t1stage "$stage" "$wt" "$run/tier1.$stage.log" || {
      inherited_red "$stage" || { tail -15 "$run/tier1.$stage.log" >&2; lastlines=$(tail -5 "$run/tier1.$stage.log"); stop 13 tier1 "Tier 1 ($stage) fails on the rebased commits${newfail:+ (a failure $base does not have: $newfail)} (log: $run/tier1.$stage.log); nothing lands."; }
      inherited=1; echo "land-direct: Tier 1 ($stage) fails, but only with failures $base already has (inherited red: not yours); landing"; }
  done
  t1=$(( $(date +%s) - ts )); prev=$bsha
  step=post-tier1-hook; run_hook post-tier1 || stop 12 refused "the post-tier1 hook refused this change (a gate that judges the tree after Tier 1, such as an attack suite; see above)"
  # Tier 1 may render generated files: dirty only in generated paths = they were stale: commit them as a commit of the lander (carrying the tip's trailers)
  dirty=$(g status --porcelain | sed 's/^...//'); strays=$(grep -vxFf <(printf '%s\n' "$gen") <<<"$dirty" || true)
  [ -z "$strays" ] || stop 13 tier1 "Tier 1 left changes outside the generated paths: $(echo $strays); not landing."
  step=commit-regenerated
  if [ -n "$dirty" ]; then
    trailers=; for t in $LAND_REQUIRE_TRAILERS; do trailers="$trailers$(g log -1 --format=%B "$tip0" | sed -n "s/^$t: *//p" | sed -n 1p | sed "s/^/$t: /")"$'\n'; done
    g add -A; g commit -qm "chore: regenerate generated files after rebase onto $base" -m "Generated by land-direct." ${trailers:+-m "${trailers%$'\n'}"}
  fi
  step=push; sha=$(g rev-parse HEAD)
  fetch_base "$gt" "$wt" || die "cannot fetch $remote $base (timed out or failed)"
  if ! g merge-base --is-ancestor "$remote/$base" HEAD; then   # base moved during Tier 1: rebase and check again
    more; echo "land-direct: $base moved during Tier 1: rebasing and checking again (attempt $attempt)"; continue
  fi
  holdcheck; freezecheck   # the verdict is only good while nobody has held or frozen landing
  [ "$dry" = 0 ] || break
  if bounded "$gt" "git push" git -C "$wt" push -q "$remote" "$sha:refs/heads/$base" 2>"$run/push.log"; then break; fi   # a plain push: the remote refuses what is not a fast-forward, and that refusal is the arbiter between landers
  # refused or timed out: ask the remote. Our commit in it = it was accepted after all; the base moved on = lost the race, again; neither = a real refusal, not retried
  fetch_base "$gt" "$wt" || die "cannot fetch $remote $base (timed out or failed)"
  if g merge-base --is-ancestor "$sha" "$remote/$base"; then echo "land-direct: the push reported a failure but ${sha:0:12} is in $base: landed"; break; fi
  sed 's/^/land-direct: push: /' "$run/push.log" >&2
  ! g merge-base --is-ancestor "$remote/$base" "$sha" || die "the push of ${sha:0:12} to $base was refused and $base has not moved: not retrying (the remote's reason is above)"
  more; echo "land-direct: lost the race for $base: rebasing and checking again (attempt $attempt)" >&2
  sleep "$(awk -v n="$attempt" -v r="$RANDOM" 'BEGIN { m = n / 2; if (m > 10) m = 10; printf "%.2f", m * r / 32768 }')"   # jitter, so losers do not collide again
done
# extra JSON keys from the json-fields hook: `key=value` lines, key [a-z_]+, value a number or [A-Za-z0-9._-]+ (anything else is null)
if [ -n "$hooks" ] && [ -x "$hooks/json-fields" ]; then
  jf=$(cd "$wt" && bounded "$st" "hook json-fields" "$hooks/json-fields" 2>/dev/null || true)
  while IFS='=' read -r k v; do [[ "$k" =~ ^[a-z_][a-z0-9_]*$ ]] || continue
    case $k in sha|commits|tier1_seconds|result|exit) continue;; esac
    if [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then extra_json="$extra_json,\"$k\":$v"; elif [[ "$v" =~ ^[A-Za-z0-9._-]+$ ]]; then extra_json="$extra_json,\"$k\":\"$v\""; else extra_json="$extra_json,\"$k\":null"; fi
  done <<<"$jf"
fi
if [ "$already" = 1 ]; then result=landed; echo "land-direct: already landed: every commit of $rev is in $base (${sha:0:12}); nothing to do"; exit 0; fi
if [ "$dry" = 1 ]; then result=would-land; echo "land-direct: dry run: would land ${sha:0:12} (tier1 ${t1}s); nothing pushed"; exit 0; fi
result=landed
echo "land-direct: ${sha:0:12} is $base: $ncommits commit(s), tier1 ${t1}s"
echo "land-direct: your branch still holds the pre-rebase commits ($base has them rebased): start the next task from a fresh worktree off $remote/$base"
