#!/usr/bin/env bash
# land-lean axiom [--selftest] | recheck [--selftest] | trust [--count]   (docs/lean-gates.md, docs/payload.md 4a)
# The Lean gates this tool ships, for a repository that has .land/lean.conf (its presence is the opt-in). The file says WHICH modules to audit, in land.conf's grammar and read by the same parser (lib/conf.sh);
# the tool owns HOW (lean/AxiomGate.lean). Run from the repository root, or set LAND_LEAN_ROOT.
#   axiom   every constant of the audited roots depends only on the three standard axioms; --selftest also runs the differential test. Needs LAND_LEAN_AXIOM_IMPORTS and LAND_LEAN_AXIOM_ROOTS.
#   recheck every proof of the modules in LAND_LEAN_RECHECK_MODULES, and of everything they import, replayed by Lean's own checker in a fresh process (leanchecker --fresh: the same kernel code, so it catches what bypassed the kernel, not a bug in it); --selftest first proves the checker rejects a planted false theorem. LEANCHECKER names another checker (a test seam).
#   trust   the trust ledger (docs/trust-ledger.md): what cannot be proven is marked as trusted, and what must appear is DERIVED from the tree and the configuration; --count prints the number of entries.
# Exit: 0 ok | 1 the gate failed | 2 usage or a refused configuration.
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")" && pwd); . "$here/../lib/conf.sh"
root=${LAND_LEAN_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
cmd=${1:-}; [ $# -eq 0 ] || shift
cf=$root/$LAND_LEAN_CONF_FILE
[ -f "$cf" ] || { echo "land-lean: no $LAND_LEAN_CONF_FILE: the Lean gates are on for a repository that has one (docs/payload.md 1a)" >&2; exit 2; }
lean_conf_defaults; conf_parse "$LAND_LEAN_CONF_FILE" "$lean_conf_keys" < "$cf" || exit 2
lean_conf_validate || exit 2
case $cmd in
  axiom)
    [ -n "$LAND_LEAN_AXIOM_IMPORTS" ] || { echo "land-lean: axiom needs LAND_LEAN_AXIOM_IMPORTS in $LAND_LEAN_CONF_FILE (the modules to import)" >&2; exit 2; }
    [ -n "$LAND_LEAN_AXIOM_ROOTS" ] || { echo "land-lean: axiom needs LAND_LEAN_AXIOM_ROOTS in $LAND_LEAN_CONF_FILE (the module roots to audit)" >&2; exit 2; }
    cd "$root"; exec lake env lean --run "$here/../lean/AxiomGate.lean" --imports "${LAND_LEAN_AXIOM_IMPORTS// /,}" --roots "${LAND_LEAN_AXIOM_ROOTS// /,}" "$@";;
  recheck)
    [ -n "$LAND_LEAN_RECHECK_MODULES" ] || { echo "land-lean: recheck needs LAND_LEAN_RECHECK_MODULES in $LAND_LEAN_CONF_FILE (the modules to replay; each replays its whole import closure)" >&2; exit 2; }
    checker=${LEANCHECKER:-leanchecker}; cd "$root"
    if [ "${1:-}" = --selftest ]; then lake env bash "$here/../lean/recheck-selftest.sh" "$checker" || exit 1; fi
    echo "recheck: replaying $LAND_LEAN_RECHECK_MODULES (and what they import) with Lean's own checker in a fresh process"
    # leanchecker --fresh takes ONE module per run, and each run replays that module's whole import closure: one run per module, side by side, one verdict per module
    logs=$(mktemp -d "${TMPDIR:-/tmp}/recheck.XXXXXX"); trap 'rm -rf "$logs"' EXIT; pids=(); mods=($LAND_LEAN_RECHECK_MODULES)
    for m in "${mods[@]}"; do ( lake env "$checker" --fresh "$m" > "$logs/$m.log" 2>&1 ) & pids+=($!); done
    rc=0; for i in "${!mods[@]}"; do
      if wait "${pids[$i]}"; then echo "recheck: ${mods[$i]} ok"; else echo "recheck: ${mods[$i]} REJECTED"; sed 's/^/  /' "$logs/${mods[$i]}.log"; rc=1; fi; done
    [ "$rc" -ne 0 ] || echo "recheck: ok"; exit "$rc";;
  trust)
    cd "$root"
    if [ "${1:-}" = --count ]; then grep -c '^### T[0-9]' docs/trust-ledger.md 2>/dev/null || echo 0; exit 0; fi
    export LAND_LEAN_TRUST_FILES LAND_LEAN_TRUST_EXTERN_DIRS LAND_LEAN_TRUST_TOOLS LAND_LEAN_TRUST_KEYS_CMD
    req=$(mktemp "${TMPDIR:-/tmp}/trust-keys.XXXXXX"); trap 'rm -f "$req"' EXIT
    bash "$here/../lean/trust-keys.sh" > "$req"
    exec python3 "$here/../lean/trust_ledger.py" docs/trust-ledger.md "$req";;
  *) echo "usage: land-lean axiom [--selftest] | recheck [--selftest] | trust [--count]" >&2; exit 2;;
esac
