# .land/land.conf: this repository's landing configuration. Data, not code: LAND_KEY=value per line, no expansion, unknown keys are errors.
# Every key and its default: the README, "Configuration". Read from origin/<base>, so a change cannot loosen the rules it is judged by.
LAND_BASE=main

# Tier 1 (the gate; target under 60 s): runs on the rebased combination. Examples by ecosystem:
#   Rust:    LAND_GATES_CMD=cargo fmt --check && cargo clippy -q -- -D warnings      LAND_TEST_CMD=cargo test -q
#   Python:  LAND_GATES_CMD=ruff check .                                              LAND_TEST_CMD=pytest -q -x
#   Node:    LAND_GATES_CMD=npm run -s lint                                           LAND_TEST_CMD=npm test --silent
#   Shell:   LAND_GATES_CMD=bash -n scripts/*.sh                                      LAND_TEST_CMD=tests/run.sh
LAND_TEST_CMD=true

# Inherited red: the lines of Tier 1's output that name a failure (a landing may pass a Tier 1 that fails only with failures the bare base also has). The default suits `FAIL ...` / `FAILED ...` lines.
# LAND_FAIL_PATTERN=^(FAIL|FAILED)([ :]|$)

# Commit rules and the gate-defining set: everything the tool owns in this repository is in .land/, and .land/ is what to protect.
#LAND_PROTECTED=.land/land.conf .land/land.d/* .land/land-direct
# A whole folder in one entry, if you want it off limits to agents: LAND_PROTECTED=.land/* (the install --signers FILE copy of land.signers
# is not a signers-file change; after it, a change to .land/land.signers needs LAND_OWNER=1)
